{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compact report",
  "schemaVersion": 1,
  "type": "object",
  "required": ["schemaVersion", "at", "counts", "deltas"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repo": {
      "type": "string"
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "at": {
      "type": "string"
    },
    "baseline": {
      "type": "boolean"
    },
    "counts": {
      "type": "object",
      "required": ["deltas", "byClass"],
      "properties": {
        "deltas": {
          "type": "integer",
          "minimum": 0
        },
        "byClass": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "filteredDeltas": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "repo",
          "entity",
          "number",
          "title",
          "url",
          "classes",
          "summary",
          "changed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "entity": {
            "enum": ["pr", "issue"]
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "classes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "new",
                "first-seen",
                "baseline-state",
                "closed",
                "reopened",
                "new-comments",
                "updated",
                "missing",
                "still-missing",
                "presumed-deleted",
                "reappeared",
                "merged",
                "draft-ready",
                "converted-to-draft",
                "ci-changed",
                "review-changed",
                "became-mergeable",
                "became-conflicting",
                "head-changed",
                "unresolved-threads-added",
                "unresolved-threads-resolved",
                "review-threads-changed",
                "relabeled",
                "comments-removed",
                "assignees-changed",
                "review-requests-changed",
                "base-changed"
              ]
            }
          },
          "summary": {
            "type": ["object", "null"]
          },
          "changed": {
            "type": "object"
          },
          "missingTicks": {
            "type": "integer",
            "minimum": 1
          },
          "enrichment": {},
          "detail": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "message"],
        "properties": {
          "repo": {
            "type": "string"
          },
          "kind": {
            "enum": ["config", "snapshot", "github", "io", "busy", "log", "rate-limit"]
          },
          "message": {
            "type": "string"
          },
          "resetAt": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
