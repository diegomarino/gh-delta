{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JSON report",
  "schemaVersion": 2,
  "$defs": {
    "delta": {
      "type": "object",
      "required": ["id", "repo", "entity", "number", "context", "classes", "summary", "changed"],
      "properties": {
        "id": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "entity": {
          "enum": ["pr", "issue"]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "context": {
          "type": "object",
          "properties": {
            "id": {
              "type": ["string", "null"]
            },
            "title": {
              "type": ["string", "null"]
            },
            "url": {
              "type": ["string", "null"]
            },
            "author": {
              "type": ["string", "null"]
            },
            "createdAt": {
              "type": ["string", "null"]
            },
            "headRefName": {
              "type": ["string", "null"]
            }
          },
          "additionalProperties": true
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "new",
              "first-seen",
              "baseline-state",
              "closed",
              "reopened",
              "new-comments",
              "updated",
              "missing",
              "still-missing",
              "presumed-deleted",
              "reappeared",
              "merged",
              "draft-ready",
              "converted-to-draft",
              "ci-changed",
              "review-changed",
              "became-mergeable",
              "became-conflicting",
              "head-changed",
              "stale",
              "unresolved-threads-added",
              "unresolved-threads-resolved",
              "review-threads-changed",
              "relabeled",
              "comments-removed",
              "assignees-changed",
              "review-requests-changed",
              "base-changed",
              "review-comments-added",
              "review-comments-removed"
            ]
          }
        },
        "summary": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "ciRollup",
                "reviewDecision",
                "mergeable",
                "mergeStateStatus",
                "state",
                "isDraft",
                "unresolvedReviewThreads",
                "headSha"
              ],
              "properties": {
                "ciRollup": {
                  "enum": ["green", "failed", "pending", "none"]
                },
                "reviewDecision": {
                  "enum": ["approved", "changes_requested", "review_required", "none"]
                },
                "mergeable": {
                  "enum": ["mergeable", "conflicting", "unknown"]
                },
                "mergeStateStatus": {
                  "enum": [
                    "behind",
                    "blocked",
                    "clean",
                    "dirty",
                    "draft",
                    "has_hooks",
                    "unstable",
                    "unknown"
                  ]
                },
                "state": {
                  "enum": ["open", "closed", "merged"]
                },
                "isDraft": {
                  "type": "boolean"
                },
                "unresolvedReviewThreads": {
                  "type": "integer",
                  "minimum": 0
                },
                "headSha": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            {
              "type": "object",
              "required": ["state"],
              "properties": {
                "state": {
                  "enum": ["open", "closed", "merged"]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "changed": {
          "type": "object",
          "additionalProperties": true
        },
        "from": {
          "type": ["object", "null"],
          "properties": {
            "state": {
              "type": "string"
            },
            "updatedAt": {
              "type": "string"
            },
            "isDraft": {
              "type": "boolean"
            },
            "headSha": {
              "type": "string"
            },
            "baseRef": {
              "type": "string"
            },
            "mergeable": {
              "type": "string"
            },
            "mergeStateStatus": {
              "type": "string"
            },
            "reviewDecision": {
              "type": "string"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "reviews": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "threads": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "conversationComments": {
              "type": "integer",
              "minimum": 0
            },
            "reviewComments": {
              "type": "integer",
              "minimum": 0
            },
            "recentComments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "assignees": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reviewRequests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "to": {
          "type": ["object", "null"],
          "properties": {
            "state": {
              "type": "string"
            },
            "updatedAt": {
              "type": "string"
            },
            "isDraft": {
              "type": "boolean"
            },
            "headSha": {
              "type": "string"
            },
            "baseRef": {
              "type": "string"
            },
            "mergeable": {
              "type": "string"
            },
            "mergeStateStatus": {
              "type": "string"
            },
            "reviewDecision": {
              "type": "string"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "reviews": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "threads": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "conversationComments": {
              "type": "integer",
              "minimum": 0
            },
            "reviewComments": {
              "type": "integer",
              "minimum": 0
            },
            "recentComments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "assignees": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reviewRequests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "missingTicks": {
          "type": "integer",
          "minimum": 1
        },
        "firstObserved": {
          "const": true
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "summaryLine": {
          "type": "string"
        },
        "enrichment": {
          "type": "object",
          "additionalProperties": true
        },
        "staleAt": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "detail": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schemaVersion",
        "detectedAt",
        "monitorId",
        "entities",
        "repos",
        "results",
        "deltas",
        "filteredDeltas",
        "warnings",
        "summary"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "detectedAt": {
          "type": "string"
        },
        "monitorId": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "enum": ["pr", "issue"]
          }
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repo", "baseline", "repoSource", "stateFile", "rateLimit"],
            "properties": {
              "repo": {
                "type": "string"
              },
              "baseline": {
                "type": "boolean"
              },
              "repoSource": {
                "type": "string"
              },
              "stateFile": {
                "type": "string"
              },
              "logFile": {
                "type": "string"
              },
              "rateLimit": {
                "type": ["object", "null"],
                "properties": {
                  "cost": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "remaining": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "resetAt": {
                    "type": "string"
                  }
                }
              },
              "error": {
                "type": "object",
                "required": ["kind", "message"],
                "properties": {
                  "kind": {
                    "enum": ["config", "snapshot", "github", "io", "busy", "log", "rate-limit"]
                  },
                  "message": {
                    "type": "string"
                  },
                  "hint": {
                    "type": "string"
                  },
                  "resetAt": {
                    "type": "string"
                  },
                  "remaining": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cost": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "deltas": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/delta"
              },
              {
                "required": ["from", "to"]
              }
            ]
          }
        },
        "filteredDeltas": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "reason"],
            "properties": {
              "label": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["schemaVersion", "at", "error", "kind"],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "at": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "kind": {
          "enum": ["config", "snapshot", "github", "io", "busy", "log", "rate-limit"]
        },
        "hint": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "monitorId": {
          "type": "string"
        },
        "resetAt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  ]
}
