{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "legacy JSON report",
  "schemaVersion": 1,
  "oneOf": [
    {
      "type": "object",
      "required": ["schemaVersion", "at", "deltas"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "at": {
          "type": "string"
        },
        "baseline": {
          "type": "boolean"
        },
        "repo": {
          "type": "string"
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monitorId": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "enum": ["pr", "issue"]
          }
        },
        "stateFile": {
          "type": "string"
        },
        "deltas": {
          "type": "array"
        },
        "error": {
          "type": "string"
        },
        "kind": {
          "enum": ["config", "snapshot", "github", "io", "busy", "log", "rate-limit"]
        },
        "hint": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "reason"],
            "properties": {
              "label": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["schemaVersion", "at", "error", "kind"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "at": {
          "type": "string"
        },
        "baseline": {
          "type": "boolean"
        },
        "repo": {
          "type": "string"
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monitorId": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "enum": ["pr", "issue"]
          }
        },
        "stateFile": {
          "type": "string"
        },
        "deltas": {
          "type": "array"
        },
        "error": {
          "type": "string"
        },
        "kind": {
          "enum": ["config", "snapshot", "github", "io", "busy", "log", "rate-limit"]
        },
        "hint": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "reason"],
            "properties": {
              "label": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  ]
}
