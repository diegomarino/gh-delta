              "additionalProperties": false
            },
            "filteredDeltas": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "exitCode": {
          "enum": [0, 1, 2, 10]
        }
      },
      "additionalProperties": true
