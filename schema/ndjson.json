                },
                "missing": {
                  "type": "integer",
                  "minimum": 1
                },
                "still-missing": {
                  "type": "integer",
                  "minimum": 1
                },
                "presumed-deleted": {
                  "type": "integer",
                  "minimum": 1
                },
                "reappeared": {
